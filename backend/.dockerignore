# Python-generated files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Historical source backups
**/*.bak
**/*.backup
**/*.orig
**/*.pre-phase*
**/*~
**/*.swp
**/*.swo

# Local development environments
**/.venv/
**/venv/
**/.env
**/.env.*
!**/.env.example

# Version control and editor metadata
**/.git/
**/.gitignore
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

# Temporary and test-generated files
**/*.tmp
**/*.temp
**/.coverage
**/htmlcov/
