# Local authentication is enabled for the initial deployment.
# DATABASE_URL has no application fallback and must be supplied through the
# protected runtime environment. Replace every placeholder below.
DATABASE_URL=postgresql+psycopg2://application-user:replace-with-secret@database-host:5432/application-db

AUTH_PROVIDER=local
AUTH_SESSION_HOURS=12
AUTH_COOKIE_NAME=compliance_session

# Keep true when the dashboard is served over HTTPS. Set false only while the
# existing internal HTTP deployment is being used.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Login failures no longer create account-wide locks. Throttles are scoped to
# the source address and to the source-address/username pair so another source
# cannot deny access to a known account. All failed logins return the same 401.
AUTH_LOGIN_SOURCE_MAX_ATTEMPTS=50
AUTH_LOGIN_THROTTLE_WINDOW_MINUTES=15
AUTH_LOGIN_INITIAL_BACKOFF_SECONDS=30
AUTH_LOGIN_MAX_BACKOFF_SECONDS=900

# Retention cleanup is manual unless an administrator explicitly schedules the
# preview/execute CLI. Executions always create an archive before deletion.
AUTH_SESSION_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=400
AUTH_RETENTION_ARCHIVE_ROOT=/app/evidence/retention/auth

# Changelog and evidence retention preview only. No archive, deletion, or
# schedule is implemented by these settings.
CHANGELOG_RETENTION_DAYS=400
VALIDATED_EVIDENCE_RETENTION_DAYS=400
UNVALIDATED_EVIDENCE_RETENTION_DAYS=400
EVIDENCE_RETENTION_ARCHIVE_ROOT=/app/evidence/retention/changelog-evidence-archives

# Comma-separated, exact frontend origins. Wildcards are intentionally rejected.
AUTH_CORS_ORIGINS=https://compliance.example.internal

# Exact Host-header values accepted by the backend. Do not include schemes,
# paths, ports, CIDR notation, or wildcards. Add a future DNS hostname before
# directing users to it.
AUTH_ALLOWED_HOSTS=compliance.example.internal,localhost,127.0.0.1,backend,aivuln-backend

# Comma-separated IP addresses or CIDR networks for reverse proxies that are
# permitted to supply X-Forwarded-For. Leave empty when clients connect
# directly. Prefer exact /32 or /128 addresses whenever possible.
AUTH_TRUSTED_PROXY_NETWORKS=

# Non-browser, separately authenticated ingestion and health endpoints.
AUTH_SERVICE_PATHS=/api/health,/api/iam/db-ingest,/api/windows-agent/ingest,/api/windows-agent/auth-check
WINDOWS_AGENT_INGEST_TOKEN=replace-with-a-random-64-character-secret
WINDOWS_AGENT_INGEST_ENFORCE_AUTH=false
WINDOWS_AGENT_LEGACY_AUTH_ENABLED=true
SSH_KNOWN_HOSTS_FILE=/app/remote-cache/known_hosts
